<Window x:Class="IisCertManager.Client.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="IIS 证书管家" Width="1160" Height="820" MinWidth="960" MinHeight="700" Loaded="OnLoaded">
<DockPanel Margin="24">
<Grid DockPanel.Dock="Top" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="IIS 证书管家" FontSize="25" FontWeight="SemiBold" Foreground="#142D45"/><TextBlock Text="本机 IIS · 自动签发 · HTTPS 绑定 · 无人值守续期" Foreground="#64748B" Margin="0,6,0,0"/></StackPanel>
<Button Grid.Column="1" Content="刷新状态" Click="OnRefresh" VerticalAlignment="Center"/>
</Grid>
<Border DockPanel.Dock="Bottom" Background="#E9EEF4" Padding="12" Margin="0,14,0,0"><StackPanel><ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,8"/><TextBlock x:Name="Status" Text="正在连接本机 Windows 服务…" TextWrapping="Wrap"/></StackPanel></Border>
<TabControl x:Name="Tabs" Background="White" Padding="16">
<TabItem Header="  IIS 站点与证书  "><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DataGrid x:Name="Sites" SelectionChanged="OnSiteSelected"><DataGrid.Columns>
<DataGridTextColumn Header="站点" Binding="{Binding SiteName}" Width="140"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="75"/>
<DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="65"/><DataGridTextColumn Header="主机名" Binding="{Binding Host}" Width="*"/>
<DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="100"/><DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="60"/>
<DataGridTextColumn Header="证书到期" Binding="{Binding Expires, StringFormat=yyyy-MM-dd}" Width="100"/>
</DataGrid.Columns></DataGrid>
<Border Grid.Row="1" BorderBrush="#DCE3EB" BorderThickness="1" Padding="14" Margin="0,16,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock x:Name="Selection" Text="选择一个有主机名的 IIS 绑定" FontWeight="SemiBold"/><TextBlock Text="证书域名（逗号分隔，可包含 *.example.com）" Margin="0,12,0,0"/><TextBox x:Name="Domains" ToolTip="必须包含或覆盖所选绑定主机名；不会自动增加其他域名的 IIS 绑定。"/>
<TextBlock Text="当前证书指纹" Foreground="#64748B"/><TextBlock x:Name="Thumbprint" Text="—" FontFamily="Consolas" TextWrapping="Wrap"/>
</StackPanel>
<StackPanel Grid.Column="2"><TextBlock Text="验证方式"/><ComboBox x:Name="Mode" SelectedIndex="0"><ComboBoxItem Content="自动（DNS 已配置优先 DNS-01）"/><ComboBoxItem Content="HTTP-01（公网 80 端口）"/><ComboBoxItem Content="DNS-01（阿里云 DNS）"/></ComboBox>
<TextBlock Text="目标 HTTPS 端口"/><TextBox x:Name="HttpsPort" Text="443"/><CheckBox x:Name="AutoRenew" Content="启用自动签发和到期续期" IsChecked="True"/>
</StackPanel></Grid></Border>
<StackPanel Grid.Row="2" Orientation="Horizontal"><Button Content="保存托管规则" Click="OnSaveProfile"/><Button Content="立即签发 / 更新绑定" Click="OnIssue" Background="#D9E8F7"/><TextBlock Text="首次请在“全局配置”保存邮箱与验证信息。" Foreground="#64748B" VerticalAlignment="Center"/></StackPanel>
</Grid></TabItem>
<TabItem Header="  托管与续期  "><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DataGrid x:Name="Profiles"><DataGrid.Columns>
<DataGridTextColumn Header="站点" Binding="{Binding SiteName}" Width="120"/><DataGridTextColumn Header="主机名" Binding="{Binding Host}" Width="180"/>
<DataGridCheckBoxColumn Header="自动" Binding="{Binding Enabled}" Width="55"/><DataGridTextColumn Header="验证" Binding="{Binding Mode}" Width="75"/>
<DataGridTextColumn Header="证书到期" Binding="{Binding Expires, StringFormat=yyyy-MM-dd}" Width="100"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*"/>
<DataGridTextColumn Header="下次尝试 UTC" Binding="{Binding NextAttempt, StringFormat=MM-dd HH:mm}" Width="120"/>
</DataGrid.Columns></DataGrid>
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0"><Button Content="编辑所选规则" Click="OnEditProfile"/><Button Content="签发所选规则" Click="OnIssueManaged"/><Button Content="暂停 / 启用续期" Click="OnToggleRenewal"/><Button Content="移除托管" Click="OnDelete"/><TextBlock Text="移除后保留 IIS 绑定和已安装证书。" VerticalAlignment="Center" Foreground="#64748B"/></StackPanel>
</Grid></TabItem>
<TabItem Header="  全局配置  "><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="650" HorizontalAlignment="Left">
<TextBlock Text="ACME 账户" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="联系邮箱" Margin="0,14,0,0"/><TextBox x:Name="Email"/>
<CheckBox x:Name="Staging" Content="测试 CA：验证完整签发流程，不安装测试证书" IsChecked="True"/>
<TextBlock TextWrapping="Wrap" Foreground="#64748B" Text="关闭测试 CA 后，保存规则将允许后台自动签发正式证书并配置 IIS。测试 CA 的证书不受浏览器信任。"/>
<TextBlock Margin="0,10,0,0"><Hyperlink NavigateUri="https://letsencrypt.org/repository/" RequestNavigate="OnNavigate">查看 Let's Encrypt 服务条款与政策</Hyperlink></TextBlock>
<CheckBox x:Name="Terms" Content="我已阅读并同意 Let's Encrypt 服务条款"/>
<TextBlock Text="到期前多少天续期（7–60）"/><TextBox x:Name="RenewDays" Text="30" Width="120" HorizontalAlignment="Left"/>
<Separator Margin="0,8,0,16"/><TextBlock Text="阿里云 DNS（可选）" FontSize="18" FontWeight="SemiBold"/>
<TextBlock x:Name="DnsStatus" Text="未配置：自动模式使用 HTTP-01" Foreground="#64748B" Margin="0,8,0,12"/>
<TextBlock Text="DNS 主域（如 example.com，不是 www.example.com）"/><TextBox x:Name="Zone"/>
<TextBlock Text="AccessKey ID（已有密钥留空保留）"/><PasswordBox x:Name="KeyId"/>
<TextBlock Text="AccessKey Secret（已有密钥留空保留）"/><PasswordBox x:Name="KeySecret"/>
<CheckBox x:Name="ClearDns" Content="清除 DNS 配置，恢复自动使用 HTTP-01"/>
<TextBlock TextWrapping="Wrap" Foreground="#64748B" Text="建议使用只具有指定主域 AddDomainRecord / DeleteDomainRecord 权限的 RAM 子账号。密钥由 Windows DPAPI 加密保存在本机，仅管理员和服务账户可访问。首版不支持 _acme-challenge CNAME 委派。" Margin="0,0,0,16"/>
<Button Content="保存全局配置" Click="OnSaveSettings" HorizontalAlignment="Left"/>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="  操作日志  "><TextBox x:Name="Logs" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0"/></TabItem>
</TabControl>
</DockPanel></Window>
