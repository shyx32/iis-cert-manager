<Window x:Class="IisCertManager.Client.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:IisCertManager.Client" Style="{StaticResource {x:Type Window}}"
 Title="IIS 证书管家" Icon="Assets/App.ico" Width="1240" Height="820" MinWidth="1060" MinHeight="720"
 WindowStartupLocation="CenterScreen" Loaded="OnLoaded" Closed="OnClosed">
 <Window.Resources><local:BindingPresentation x:Key="BindingView"/></Window.Resources>
 <Grid Background="#F6F8FB">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="White" Padding="24,12" BorderBrush="#E6EAF0" BorderThickness="0,0,0,1">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Image Source="Assets/App.png" Width="36" Height="36" Margin="0,0,12,0"/>
     <StackPanel><TextBlock Text="IIS 证书管家" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="网站证书与自动续期" Style="{StaticResource Hint}" Margin="0,3,0,0"/></StackPanel>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="RefreshButton" Content="同步 IIS" Click="OnRefresh" Margin="0" ToolTip="读取本机 IIS 最新配置；空闲时不会自动同步"/>
    </StackPanel>
   </Grid>
  </Border>
  <TabControl Grid.Row="1" x:Name="Tabs">
   <TabItem Header="站点与证书">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <WrapPanel Margin="0,0,0,12" VerticalAlignment="Center">
      <TextBlock Text="站点 / 绑定" Style="{StaticResource Hint}" VerticalAlignment="Center"/><TextBlock x:Name="SiteCount" Text="—" FontWeight="SemiBold" Margin="8,0,24,0" VerticalAlignment="Center"/>
      <TextBlock Text="HTTPS / 临近到期" Style="{StaticResource Hint}" VerticalAlignment="Center"/><TextBlock x:Name="CertificateCount" Text="—" FontWeight="SemiBold" Margin="8,0,24,0" VerticalAlignment="Center"/>
      <TextBlock Text="续期" Style="{StaticResource Hint}" VerticalAlignment="Center"/><TextBlock x:Name="RenewalSummary" Text="—" Margin="8,0,0,0" VerticalAlignment="Center"/>
     </WrapPanel>
     <Border Grid.Row="1" x:Name="SetupNotice" Background="#EFF6FF" CornerRadius="6" Padding="14,10" Margin="0,0,0,16" Visibility="Collapsed">
      <DockPanel><Button DockPanel.Dock="Right" Content="前往设置" Click="OnOpenSettings" Style="{StaticResource LinkButton}" Margin="16,0,0,0"/>
       <TextBlock Text="首次使用：填写联系邮箱并同意服务条款，即可开始签发。" Foreground="#1D4ED8" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
     </Border>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailColumn" Width="0"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="0">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="18,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
         <TextBlock Text="IIS 站点绑定" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
         <TextBox Grid.Column="1" x:Name="Search" TextChanged="OnSearch" Margin="0" ToolTip="搜索站点、域名、IP 或协议" AutomationProperties.Name="搜索站点或域名">
          <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5"><Grid><TextBlock Margin="10,8" x:Name="Placeholder" Visibility="Collapsed" Text="搜索站点、域名或 IP" Foreground="#94A3B8" IsHitTestVisible="False"/><ScrollViewer x:Name="PART_ContentHost"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Opacity" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></TextBox.Style>
         </TextBox>
        </Grid>
        <Grid Grid.Row="1">
         <DataGrid x:Name="Sites" SelectionChanged="OnSiteSelected" RowHeight="56"><DataGrid.Columns>
          <DataGridTemplateColumn Header="域名" SortMemberPath="Host" Width="*" MinWidth="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource BindingView}, ConverterParameter=host}" Style="{StaticResource CellText}" FontWeight="Medium"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTextColumn Header="站点" Binding="{Binding SiteName}" Width="*" MinWidth="140" ElementStyle="{StaticResource CellText}"/>
          <DataGridTemplateColumn Header="协议" SortMemberPath="Protocol" Width="80" HeaderStyle="{StaticResource CenterHeader}"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding Converter={StaticResource BindingView}, ConverterParameter=protocolBackground}" CornerRadius="4" Padding="7,3" HorizontalAlignment="Center"><TextBlock Text="{Binding Protocol}" FontSize="11" Foreground="{Binding Converter={StaticResource BindingView}, ConverterParameter=protocolForeground}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="72" HeaderStyle="{StaticResource CenterHeader}" ElementStyle="{StaticResource CenterCellText}"/>
          <DataGridTemplateColumn Header="证书状态" SortMemberPath="Expires" Width="118" HeaderStyle="{StaticResource CenterHeader}"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel HorizontalAlignment="Center"><TextBlock TextAlignment="Center" Text="{Binding Converter={StaticResource BindingView}, ConverterParameter=status}" Foreground="{Binding Converter={StaticResource BindingView}, ConverterParameter=statusForeground}" FontSize="12"/><TextBlock TextAlignment="Center" Text="{Binding Expires, StringFormat=yyyy-MM-dd}" Foreground="#64748B" FontSize="11" Margin="0,3,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Expires}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         </DataGrid.Columns></DataGrid>
         <TextBlock x:Name="EmptySites" Text="没有匹配的站点绑定" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>
        <Border Grid.Row="2" BorderBrush="#EDF0F5" BorderThickness="0,1,0,0" Padding="18,12"><TextBlock x:Name="BindingSummary" Text="正在读取本机 IIS…" Style="{StaticResource Hint}"/></Border>
       </Grid>
      </Border>
      <Border Grid.Column="1" x:Name="DetailPanel" Style="{StaticResource Card}" Padding="0" Margin="16,0,0,0" Visibility="Collapsed">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border BorderBrush="#EDF0F5" BorderThickness="0,0,0,1" Padding="18,16"><DockPanel><Button Content="收起" DockPanel.Dock="Right" Click="OnCloseDetails" Style="{StaticResource LinkButton}" Margin="8,0,0,0"/><TextBlock Text="HTTPS 配置" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel></Border>
        <ScrollViewer x:Name="DetailScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="18,12">
         <StackPanel.Resources><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="0,4,0,8"/></Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="0,4,0,8"/></Style></StackPanel.Resources>
         <TextBlock Text="证书域名" Style="{StaticResource Label}"/><TextBox x:Name="Domains" ToolTip="多个域名用逗号分隔，必须覆盖所选绑定主机名。"/>
         <TextBlock Text="验证方式" Style="{StaticResource Label}"/><ComboBox x:Name="Mode" SelectedIndex="0" ToolTip="自动模式优先使用已配置的阿里云 DNS；未配置时使用 HTTP-01。"><ComboBoxItem Content="自动选择"/><ComboBoxItem Content="HTTP-01"/><ComboBoxItem Content="阿里云 DNS-01"/></ComboBox>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="HTTPS 端口" Style="{StaticResource Label}"/><TextBox x:Name="HttpsPort" Text="443"/></StackPanel><CheckBox Grid.Column="1" x:Name="AutoRenew" Content="自动续期" IsChecked="True" VerticalAlignment="Center" Margin="20,10,0,0"/></Grid>
         <TextBlock x:Name="CertificateSummary" Text="未绑定证书" Style="{StaticResource Hint}" Margin="0,0,0,12" TextWrapping="Wrap"/>
         <Expander Header="站点与证书详情" Foreground="#64748B" FontSize="12"><StackPanel Margin="0,12,0,0">         <TextBlock x:Name="Selection" Text="选择站点绑定" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
         <TextBlock x:Name="BindingDetails" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,12"/>
<TextBlock Text="当前证书"/><TextBlock x:Name="CertificateDetails" Text="未绑定证书" TextWrapping="Wrap" Margin="0,4,0,12"/><TextBlock Text="应用池"/><TextBlock x:Name="PoolDetails" Text="—" TextWrapping="Wrap" Margin="0,4,0,12"/><TextBlock Text="网站目录"/><TextBlock x:Name="RootPath" Text="—" TextWrapping="Wrap" Margin="0,4,0,12"/><TextBlock Text="证书指纹"/><TextBlock x:Name="Thumbprint" Text="—" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4,0,10"/><Button Content="重新读取所选绑定" Click="OnReloadSelection" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"/></StackPanel></Expander>
        </StackPanel></ScrollViewer>
        <Border Grid.Row="2" Padding="18,14" BorderBrush="#EDF0F5" BorderThickness="0,1,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="IssueButton" Content="签发并部署" Click="OnIssue" Style="{StaticResource Primary}" Margin="0"/><Button Grid.Column="2" Content="保存规则" Click="OnSaveProfile" Margin="0"/></Grid></Border>
       </Grid>
      </Border>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="托管规则">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,20"><TextBlock Text="托管与续期" Style="{StaticResource PageTitle}"/><TextBlock Text="后台服务持续处理已启用的规则，关闭界面后仍会运行。" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel>
     <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><Grid>
      <DataGrid x:Name="Profiles" RowHeight="50"><DataGrid.Columns><DataGridTextColumn Header="站点" Binding="{Binding SiteName}" Width="*" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="主机名" Binding="{Binding Host}" Width="*" ElementStyle="{StaticResource CellText}"/><DataGridCheckBoxColumn Header="续期" Binding="{Binding Enabled}" Width="64"/><DataGridTextColumn Header="验证" Binding="{Binding Mode}" Width="80" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="证书到期" Binding="{Binding Expires, StringFormat=yyyy-MM-dd}" Width="116" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="下次尝试 UTC" Binding="{Binding NextAttempt, StringFormat=MM-dd HH:mm}" Width="120" ElementStyle="{StaticResource CellText}"/></DataGrid.Columns></DataGrid>
      <StackPanel x:Name="EmptyProfiles" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="尚无托管规则" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="在“站点与证书”中选择绑定并保存规则。" Style="{StaticResource Hint}" Margin="0,10,0,0"/></StackPanel>
     </Grid></Border>
     <WrapPanel Grid.Row="2" Margin="0,16,0,0" IsEnabled="{Binding SelectedItem, ElementName=Profiles, Converter={StaticResource HasSelection}}"><Button Content="编辑规则" Click="OnEditProfile"/><Button Content="立即签发" Click="OnIssueManaged"/><Button Content="暂停 / 启用续期" Click="OnToggleRenewal"/><Button Content="移除规则" Click="OnDelete"/><TextBlock Text="移除规则会保留 IIS 绑定与证书。" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,0"/></WrapPanel>
    </Grid>
   </TabItem>
   <TabItem Header="签发设置">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,20"><TextBlock Text="签发设置" Style="{StaticResource PageTitle}"/><TextBlock Text="配置证书账户、验证方式与续期时间。" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel>
       <TextBlock Text="证书账户" Style="{StaticResource SectionTitle}"/><TextBlock Text="使用 Let's Encrypt 自动签发证书。" Style="{StaticResource Hint}" Margin="0,5,0,20"/>
       <TextBlock Text="联系邮箱" Style="{StaticResource Label}"/><TextBox x:Name="Email"/>
       <CheckBox x:Name="Staging" Content="使用测试 CA" IsChecked="True"/>
       <TextBlock Text="测试签发不会安装证书。关闭后使用正式 CA，并允许已启用的规则自动签发及部署。" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,16"/>
       <TextBlock><Hyperlink NavigateUri="https://letsencrypt.org/repository/" RequestNavigate="OnNavigate">查看服务条款与政策</Hyperlink></TextBlock><CheckBox x:Name="Terms" Content="我已阅读并同意服务条款" Margin="0,12,0,22"/>
       <Separator Margin="0,0,0,20"/><TextBlock Text="自动续期" Style="{StaticResource SectionTitle}"/><TextBlock Text="到期前续期天数" Style="{StaticResource Label}" Margin="0,16,0,0"/><StackPanel Orientation="Horizontal" Margin="0,6,0,16"><TextBox x:Name="RenewDays" Text="30" Width="88" Margin="0"/><TextBlock Text="天（7–60 天）" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel><TextBlock Text="后台每 15 分钟检查一次，无需保持界面打开。" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
      </StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel>
       <DockPanel><Border DockPanel.Dock="Right" Background="#F1F5F9" CornerRadius="4" Padding="8,3"><TextBlock Text="可选" Style="{StaticResource Hint}"/></Border><TextBlock Text="阿里云 DNS" Style="{StaticResource SectionTitle}"/></DockPanel>
       <TextBlock Text="支持 DNS-01 与泛域名证书。" Style="{StaticResource Hint}" Margin="0,5,0,20"/><TextBlock x:Name="DnsStatus" Text="未配置时，自动模式使用 HTTP-01。" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,16"/>
       <TextBlock Text="DNS 主域" Style="{StaticResource Label}"/><TextBox x:Name="Zone" ToolTip="如 example.com，不是 www.example.com"/>
       <TextBlock Text="AccessKey ID" Style="{StaticResource Label}"/><PasswordBox x:Name="KeyId"/>
       <TextBlock Text="AccessKey Secret" Style="{StaticResource Label}"/><PasswordBox x:Name="KeySecret"/>
       <TextBlock Text="已有密钥留空即可保留。密钥加密保存在本机。" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,14"/>
       <CheckBox x:Name="ClearDns" Content="清除 DNS 配置"/><TextBlock Text="建议使用仅有指定主域 DNS 操作权限的 RAM 子账号。" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
      </StackPanel></Border>
     </Grid></ScrollViewer>
     <Button Grid.Row="2" Content="保存设置" Click="OnSaveSettings" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,16,0,0" MinWidth="120"/>
    </Grid>
   </TabItem>
   <TabItem Header="操作日志">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,20"><TextBlock Text="操作日志" Style="{StaticResource PageTitle}"/><Button x:Name="CopyLogsButton" Content="复制日志" Click="OnCopyLogs" HorizontalAlignment="Right" Margin="0"/></Grid><Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><Grid><TextBlock x:Name="EmptyLogs" Text="暂无操作日志" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBox x:Name="Logs" IsReadOnly="True" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" Background="Transparent" AutomationProperties.Name="操作日志内容" BorderThickness="0" Margin="0" Padding="18" TextWrapping="NoWrap" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></Grid></Border></Grid>
   </TabItem>
  </TabControl>
  <Border Grid.Row="2" Margin="0,20,0,0" Background="White" BorderBrush="#E6EAF0" BorderThickness="0,1,0,0">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ProgressBar x:Name="Progress" Height="2" IsIndeterminate="True" Visibility="Collapsed"/><Grid Grid.Row="1" Margin="24,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Text="正在连接本机 Windows 服务…" FontSize="12" TextWrapping="Wrap"/><TextBlock Grid.Column="1" x:Name="SyncStatus" Text="尚未同步" Style="{StaticResource Hint}" Margin="16,0,0,0"/></Grid></Grid>
  </Border>
 </Grid>
</Window>
